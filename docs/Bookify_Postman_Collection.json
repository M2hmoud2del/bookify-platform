{
  "info": {
    "_postman_id": "7c96b365-2a5f-4c4d-94df-bookify-phase3",
    "name": "Bookify Phase 3 - Provider & Services",
    "description": "Postman collection for the implemented Phase 3 APIs in this project. The actual routes use /api/v1, for example /api/v1/providers and /api/v1/services.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "providerEmail", "value": "provider1@example.com" },
    { "key": "providerPassword", "value": "password123" },
    { "key": "customerEmail", "value": "customer1@example.com" },
    { "key": "customerPassword", "value": "password123" },
    { "key": "providerToken", "value": "" },
    { "key": "customerToken", "value": "" },
    { "key": "providerId", "value": "" },
    { "key": "providerUserId", "value": "" },
    { "key": "serviceId", "value": "" },
    { "key": "appointmentId", "value": "" },
    { "key": "checkoutSessionId", "value": "" },
    { "key": "reviewId", "value": "" }
  ],
  "item": [
    {
      "name": "Setup Auth",
      "item": [
        {
          "name": "Register Provider",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Provider\",\n  \"email\": \"{{providerEmail}}\",\n  \"password\": \"{{providerPassword}}\",\n  \"role\": \"provider\",\n  \"phone\": \"01000000000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Run once to create a provider user. If the user already exists, use Login Provider instead."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('providerToken', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Provider",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{providerEmail}}\",\n  \"password\": \"{{providerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Gets a JWT and saves it as providerToken for protected provider/service requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('providerToken', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Google OAuth Start - Customer",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/google?role=customer",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "google"],
              "query": [
                { "key": "role", "value": "customer" }
              ]
            },
            "description": "Starts Google OAuth for a customer account. Because Google OAuth is browser-based, open this request in a browser/Postman OAuth flow and complete Google login. The callback returns a JWT JSON response."
          }
        },
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"role\": \"customer\",\n  \"phone\": \"01100000000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Run once to create a customer user. If the user already exists, use Login Customer instead."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('customerToken', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Gets a customer JWT and saves it as customerToken for appointment and payment requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('customerToken', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Google OAuth Start - Provider",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/google?role=provider",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "google"],
              "query": [
                { "key": "role", "value": "provider" }
              ]
            },
            "description": "Starts Google OAuth for a provider account. New Google users created through this route get role provider; existing users keep their current role."
          }
        },
        {
          "name": "Google OAuth Callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/google/callback",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "google", "callback"]
            },
            "description": "Google redirects here after successful login. Do not call this manually unless Google has provided the callback query parameters."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('providerToken', json.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Provider Profile Management",
      "item": [
        {
          "name": "Create or Update Provider Profile",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{providerToken}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessName\": \"Cairo Wellness Studio\",\n  \"bio\": \"Professional wellness and consultation services.\",\n  \"category\": \"Wellness\",\n  \"address\": \"123 Nile Street\",\n  \"city\": \"Cairo\",\n  \"profileImage\": \"https://example.com/provider.jpg\",\n  \"timezone\": \"Africa/Cairo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/provider/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "provider", "profile"]
            },
            "description": "Creates the profile on first request, then updates it on later requests. businessName is required only for first creation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.profile && json.profile._id) pm.collectionVariables.set('providerId', json.profile._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get My Provider Profile",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{providerToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/provider/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "provider", "profile"]
            },
            "description": "Protected route for the logged-in provider's own profile."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.profile && json.profile._id) pm.collectionVariables.set('providerId', json.profile._id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Public Provider Browsing",
      "item": [
        {
          "name": "Search Providers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/providers?search=wellness&city=Cairo&category=Wellness",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "providers"],
              "query": [
                { "key": "search", "value": "wellness" },
                { "key": "city", "value": "Cairo" },
                { "key": "category", "value": "Wellness" }
              ]
            },
            "description": "Public provider search. Supported filters: search, city, category."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (!pm.collectionVariables.get('providerId') && json.providers && json.providers[0]) {",
                  "  pm.collectionVariables.set('providerId', json.providers[0]._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Public Provider Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/providers/{{providerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "providers", "{{providerId}}"]
            },
            "description": "Public provider profile by provider profile id, not user id."
          }
        },
        {
          "name": "View Provider Services",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/providers/{{providerId}}/services",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "providers", "{{providerId}}", "services"]
            },
            "description": "Public list of active services for a provider profile id."
          }
        }
      ]
    },
    {
      "name": "Service Management",
      "item": [
        {
          "name": "Create Service",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{providerToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Initial Consultation\",\n  \"description\": \"A 60-minute introductory consultation.\",\n  \"category\": \"Wellness\",\n  \"price\": 250,\n  \"durationMinutes\": 60,\n  \"images\": [\n    \"https://example.com/service.jpg\"\n  ],\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/services",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services"]
            },
            "description": "Protected provider-only route. Saves returned service._id as serviceId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.service && json.service._id) pm.collectionVariables.set('serviceId', json.service._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Service",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{providerToken}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Consultation\",\n  \"description\": \"Updated consultation details.\",\n  \"category\": \"Consulting\",\n  \"price\": 300,\n  \"durationMinutes\": 45,\n  \"images\": [\n    \"https://example.com/updated-service.jpg\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/services/{{serviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services", "{{serviceId}}"]
            },
            "description": "Protected provider-only route. You can send any one or more editable service fields."
          }
        },
        {
          "name": "Disable Service",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{providerToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": false\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/v1/services/{{serviceId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services", "{{serviceId}}", "status"]
            },
            "description": "Protected provider-only route. Disabled services will not show in public GET service routes."
          }
        },
        {
          "name": "Enable Service",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{providerToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": true\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/v1/services/{{serviceId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services", "{{serviceId}}", "status"]
            },
            "description": "Protected provider-only route. Run this before testing public Get Service By Id if you disabled it."
          }
        },
        {
          "name": "Delete Service",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{providerToken}}", "type": "string" }] },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/services/{{serviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services", "{{serviceId}}"]
            },
            "description": "Protected provider-only route. This soft-deletes the service and sets isActive false. Run it last."
          }
        }
      ]
    },
    {
      "name": "Public Services Browsing",
      "item": [
        {
          "name": "Get Services",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/services?search=consultation&category=Wellness&minPrice=100&maxPrice=500",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services"],
              "query": [
                { "key": "search", "value": "consultation" },
                { "key": "category", "value": "Wellness" },
                { "key": "minPrice", "value": "100" },
                { "key": "maxPrice", "value": "500" }
              ]
            },
            "description": "Public active-service search. Supported filters: search, category, minPrice, maxPrice."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (!pm.collectionVariables.get('serviceId') && json.services && json.services[0]) {",
                  "  pm.collectionVariables.set('serviceId', json.services[0]._id);",
                  "  if (json.services[0].provider && json.services[0].provider._id) pm.collectionVariables.set('providerUserId', json.services[0].provider._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Service By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/services/{{serviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services", "{{serviceId}}"]
            },
            "description": "Public service details by active service id."
          }
        }
      ]
    },
    {
      "name": "Phase 6 Payments",
      "item": [
        {
          "name": "Create Appointment For Payment",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"{{providerUserId}}\",\n  \"serviceId\": \"{{serviceId}}\",\n  \"date\": \"2026-07-20\",\n  \"startTime\": \"10:00\",\n  \"notes\": \"Payment flow test appointment\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments"]
            },
            "description": "Creates a pending_payment appointment as a customer. Run Login Customer and Get Services first so customerToken, providerUserId, and serviceId are set."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data._id) pm.collectionVariables.set('appointmentId', json.data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Checkout Session",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentId\": \"{{appointmentId}}\",\n  \"successUrl\": \"http://localhost:4200/payments/success?session_id={CHECKOUT_SESSION_ID}\",\n  \"cancelUrl\": \"http://localhost:4200/payments/cancel\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/create-checkout-session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "create-checkout-session"]
            },
            "description": "Creates a Stripe Sandbox Checkout Session. Open data.checkoutUrl in the browser to pay with a Stripe test card."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.sessionId) pm.collectionVariables.set('checkoutSessionId', json.data.sessionId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get My Payments - Customer",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "my"]
            },
            "description": "Returns payments for the logged-in customer."
          }
        },
        {
          "name": "Get My Payments - Provider",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{providerToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "my"]
            },
            "description": "Returns payments for the logged-in provider."
          }
        },
        {
          "name": "Stripe Webhook",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Stripe-Signature", "value": "use-stripe-cli-forwarding-for-real-signature" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_test_webhook\",\n  \"type\": \"checkout.session.completed\",\n  \"data\": {\n    \"object\": {\n      \"id\": \"{{checkoutSessionId}}\",\n      \"payment_intent\": \"pi_test\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhooks/stripe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhooks", "stripe"]
            },
            "description": "Stripe requires a valid signed raw body. For real testing, run: stripe listen --forward-to localhost:5000/api/webhooks/stripe"
          }
        }
      ]
    },
    {
      "name": "Phase 7 Reviews",
      "item": [
        {
          "name": "Create Review",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentId\": \"{{appointmentId}}\",\n  \"rating\": 5,\n  \"comment\": \"Excellent service, very professional!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reviews"]
            },
            "description": "Creates a review for a completed appointment. Only the customer who booked the appointment can leave a review. Duplicate reviews are prevented."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.review && json.data.review._id) pm.collectionVariables.set('reviewId', json.data.review._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Review - Duplicate (Should Fail)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentId\": \"{{appointmentId}}\",\n  \"rating\": 4,\n  \"comment\": \"Trying to leave a second review\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reviews"]
            },
            "description": "Attempts to create a duplicate review for the same appointment. Should return 409 Conflict."
          }
        },
        {
          "name": "Get Provider Reviews",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reviews/provider/{{providerUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reviews", "provider", "{{providerUserId}}"]
            },
            "description": "Public endpoint. Returns all reviews for a provider along with their average rating."
          }
        },
        {
          "name": "Get My Reviews",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reviews/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reviews", "my"]
            },
            "description": "Returns all reviews written by the logged-in customer."
          }
        }
      ]
    },
    {
      "name": "Phase 7 Dashboard",
      "item": [
        {
          "name": "Get Provider Dashboard",
